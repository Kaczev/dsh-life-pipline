{
  "name": "dsh-lpipe-bili",
  "version": "0.2.4",
  "type": "module",
  "description": "Read-only Bilibili browsing, QR login and storyboard viewing for DSH.",
  "main": "src/index.js",
  "license": "AGPL-3.0-or-later",
  "icon": "assets/icon.png",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./icon": "./assets/icon.png",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "client",
    "assets",
    "locale",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dependencies": {
    "dsh-life-core": "^0.1.0",
    "qrcode": "1.5.4"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "build-client": "node scripts/build-client.mjs"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaczev/dsh-life-pipline.git",
    "directory": "components/dsh-lpipe-bili"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "life-pipeline"
  ]
}
