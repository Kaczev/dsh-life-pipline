{
  "name": "dsh-lpipe-wake",
  "version": "0.2.0",
  "description": "Self-wake pipeline for DSH: after you stop for a while, it wakes you in your main session.",
  "type": "module",
  "main": "src/index.js",
  "license": "AGPL-3.0-or-later",
  "icon": "assets/icon.png",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./icon": "./assets/icon.png",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "client",
    "assets",
    "locale",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wake",
    "life-pipeline"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaczev/dsh-life-pipline.git",
    "directory": "components/dsh-lpipe-wake"
  },
  "dependencies": {
    "dsh-life-pipline": "^0.6.1"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "build-client": "node scripts/build-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
