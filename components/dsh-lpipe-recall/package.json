{
  "name": "dsh-lpipe-recall",
  "version": "0.1.4",
  "description": "回忆管线（Lpipe Recall）：把与眼前这段话相关的旧记忆，模糊地摆到模型面前。",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json",
    "./icon": "./assets/icon.png"
  },
  "files": [
    "src",
    "lib",
    "client",
    "locale",
    "assets",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.2.0-rc.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "recall"
  ],
  "license": "MIT",
  "dependencies": {
    "dsh-life-pipline": "^0.7.5",
    "dsh-lpipe-memory": "^0.1.2",
    "dsh-lpipe-starmap": "^0.1.3"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "build-client": "node scripts/build-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "icon": "assets/icon.png"
}
