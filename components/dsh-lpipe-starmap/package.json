{
  "name": "dsh-lpipe-starmap",
  "version": "0.1.4",
  "description": "Star map for DSH: turn raw memory into a deterministic index of concepts and the sentences that bind them.",
  "type": "module",
  "main": "src/index.js",
  "license": "AGPL-3.0-or-later",
  "icon": "assets/icon.png",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./icon": "./assets/icon.png",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json",
    "./brightness": "./src/brightness.mjs",
    "./time": "./src/time.mjs",
    "./match": "./src/match.mjs",
    "./build": "./src/build.mjs",
    "./fuzzy": "./src/fuzzy.mjs",
    "./llm": "./src/llm.mjs",
    "./paths": "./src/paths.mjs",
    "./query": "./src/query.mjs",
    "./store": "./src/store.mjs",
    "./segment": "./src/segment.mjs"
  },
  "files": [
    "src",
    "lib",
    "client",
    "assets",
    "locale",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "starmap",
    "concepts",
    "life-pipeline"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaczev/dsh-life-pipline.git",
    "directory": "components/dsh-lpipe-starmap"
  },
  "dependencies": {
    "dsh-life-core": "^0.1.0",
    "dsh-lpipe-memory": "^0.1.3"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "build-client": "node scripts/build-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.2.0-rc.2"
  }
}
