{
  "name": "dsh-lpipe-memory",
  "version": "0.1.3",
  "type": "module",
  "description": "把会话原文逐字投影到长期文件：按会话分文件夹，按天分卷，哈希链可校验。",
  "license": "AGPL-3.0-or-later",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./reader": "./src/reader.mjs",
    "./paths": "./src/paths.mjs",
    "./scope": "./src/scope.mjs",
    "./client": "./lib/client.js",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json",
    "./icon": "./assets/icon.png"
  },
  "dependencies": {
    "dsh-life-core": "^0.1.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "build-client": "node scripts/build-client.mjs"
  },
  "files": [
    "src",
    "lib",
    "client",
    "assets",
    "locale",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaczev/dsh-life-pipline.git",
    "directory": "components/dsh-lpipe-memory"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "icon": "assets/icon.png"
}
