{
  "name": "dsh-life-pipline",
  "version": "0.8.2",
  "description": "All-in-one Life Pipline installer: Life Core and seven independently switchable pipelines.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "test": "node scripts/link-self.mjs && node --test \"test/*.test.mjs\" \"components/*/test/*.test.mjs\"",
    "install-local": "node scripts/install-local.mjs",
    "build-client": "node scripts/build-clients.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaczev/dsh-life-pipline.git"
  },
  "files": [
    "lib",
    "client",
    "index.js",
    "assets",
    "locale",
    "LICENSE",
    "README.md",
    "src",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "type": "module",
  "main": "index.js",
  "icon": "assets/icon.png",
  "exports": {
    "./client": "./lib/client.js",
    ".": "./index.js",
    "./clock": "./src/clock.mjs",
    "./session": "./src/session-activity.mjs",
    "./icon": "./assets/icon.png",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json",
    "./session-title": "./src/session-title.mjs",
    "./diagnostics": "./src/diagnostics.mjs",
    "./main-session": "./src/main-session.mjs"
  },
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.2.0-rc.2"
  },
  "dependencies": {
    "dsh-life-core": "^0.1.0",
    "dsh-lpipe-chat": "^0.7.8",
    "dsh-lpipe-home": "^0.2.2",
    "dsh-lpipe-bili": "^0.2.3",
    "dsh-lpipe-wake": "^0.2.7",
    "dsh-lpipe-memory": "^0.1.3",
    "dsh-lpipe-starmap": "^0.1.6",
    "dsh-lpipe-recall": "^0.1.9"
  },
  "dsh": {
    "client": {"inject": ["@deepseek-ai/dsh-client-ui-slots"], "platform": "web"},
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
