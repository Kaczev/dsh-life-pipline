{
  "name": "dsh-life-pipline",
  "version": "1.0.3",
  "workspaces": [
    "components/dsh-lpipe-bili",
    "components/dsh-lpipe-chat",
    "components/dsh-lpipe-focus",
    "components/dsh-lpipe-home",
    "components/dsh-lpipe-memory",
    "components/dsh-lpipe-tone",
    "components/dsh-lpipe-wake"
  ],
  "description": "All-in-one Life Pipline installer: Life Core and seven independently switchable pipelines.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "test": "node scripts/test.mjs",
    "install-local": "node scripts/install-local.mjs",
    "build-client": "node scripts/build-clients.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaczev/dsh-life-pipline.git"
  },
  "files": [
    "lib",
    "client",
    "index.js",
    "assets",
    "locale",
    "LICENSE",
    "README.md",
    "src",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "type": "module",
  "main": "index.js",
  "icon": "assets/icon.png",
  "exports": {
    "./client": "./lib/client.js",
    ".": "./index.js",
    "./clock": "./src/clock.mjs",
    "./session": "./src/session-activity.mjs",
    "./icon": "./assets/icon.png",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json",
    "./session-title": "./src/session-title.mjs",
    "./diagnostics": "./src/diagnostics.mjs",
    "./main-session": "./src/main-session.mjs"
  },
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.2.0-rc.2"
  },
  "dependencies": {
    "dsh-life-core": "^0.1.2",
    "dsh-lpipe-chat": "^0.7.14",
    "dsh-lpipe-home": "^0.2.5",
    "dsh-lpipe-bili": "^0.2.7",
    "dsh-lpipe-wake": "^0.2.12",
    "dsh-lpipe-memory": "^2.0.0",
    "dsh-lpipe-tone": "^1.0.0",
    "dsh-lpipe-focus": "^2.5.1"
  },
  "dsh": {
    "client": {"inject": ["@deepseek-ai/dsh-client-ui-slots"], "platform": "web"},
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
