{
  "name": "dsh-life-pipline",
  "version": "0.7.2",
  "description": "Common settings for the dsh-lpipe- series: every component registers a block into one shared Settings page.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "test": "node scripts/link-self.mjs && node --test \"test/*.test.mjs\" \"components/*/test/*.test.mjs\"",
    "install-local": "node scripts/install-local.mjs",
    "build-client": "node scripts/build-clients.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaczev/dsh-life-pipline.git"
  },
  "files": [
    "index.js",
    "lib",
    "client",
    "assets",
    "locale",
    "LICENSE",
    "README.md",
    "src",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "type": "module",
  "main": "index.js",
  "icon": "assets/icon.png",
  "exports": {
    ".": "./index.js",
    "./clock": "./src/clock.mjs",
    "./session": "./src/session-activity.mjs",
    "./client": "./lib/client.js",
    "./icon": "./assets/icon.png",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json",
    "./session-title": "./src/session-title.mjs",
    "./diagnostics": "./src/diagnostics.mjs"
  },
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
