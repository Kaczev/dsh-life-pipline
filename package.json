{
  "name": "dsh-life-pipline",
  "version": "0.2.0",
  "private": true,
  "description": "A DSH life bundle that grows one component at a time.",
  "type": "module",
  "main": "index.js",
  "icon": "assets/icon.png",
  "exports": {
    ".": "./index.js",
    "./icon": "./assets/icon.png",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.2.0-rc.2 <0.2.2-0"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test \"components/*/test/*.test.mjs\"",
    "install-local": "node scripts/install-local.mjs",
    "build-client": "node components/dsh-lpipe-chat/scripts/build-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
